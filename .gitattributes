# Unreal binary assets: no useful text diff, and they do not delta-compress.
# Every edit to a 256MB texture adds another 256MB to history forever, so these
# are routed to Git LFS. NOTE: this repo needs ~6GB of LFS; GitHub's free tier
# is 1GB storage / 1GB bandwidth per month, so pushing requires a paid data
# pack (or Azure DevOps, which gives unlimited LFS free).
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.uptnl   filter=lfs diff=lfs merge=lfs -text
*.dna     filter=lfs diff=lfs merge=lfs -text
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text

# keep line endings sane for the text side
*.py      text eol=lf
*.md      text eol=lf
*.bat     text eol=crlf
