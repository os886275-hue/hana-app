# Copy to .env and fill in. NEVER commit the real .env -- it holds a token.

# HuggingFace token, needed to pull the gated VoiceTut TTS model
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the app writes the synthesised WAV. Unreal imports it from this path,
# so it must be readable by the editor on the SAME machine.
UNREAL_AUDIO_DIR=F:\or\avatar1\audio

# Unreal editor Remote Control API (Project Settings > Plugins > Remote Control)
UE_RC_HOST=127.0.0.1
UE_RC_PORT=30010
UE_RC_TIMEOUT=60

# Pixel Streaming signalling server (what the app iframes)
PIXEL_STREAM_URL=http://localhost/

# Port this app serves on
HANA_APP_PORT=5001

# Seconds the exported audio track is scheduled AHEAD of the animation, to
# compensate for audio device latency. Tune by ear: lips lead -> raise,
# lips lag -> lower. Do not tune this over RDP; the result is meaningless.
UNREAL_AUDIO_LATENCY_COMPENSATION=0.04
